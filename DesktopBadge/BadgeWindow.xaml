<Window x:Class="DesktopBadge.BadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Badge"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsTabStop="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- The 10px margin gives the drop shadow room to render. -->
    <Grid x:Name="Root" Margin="10" Opacity="1">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="9" ShadowDepth="1.5" Direction="270" Opacity="0.5" Color="#000000" />
        </Grid.Effect>

        <Grid x:Name="Rotator" RenderTransformOrigin="0.5,0.5">
            <Grid.LayoutTransform>
                <RotateTransform x:Name="Rotation" Angle="0" />
            </Grid.LayoutTransform>

            <Border x:Name="Pill"
                    CornerRadius="8"
                    BorderThickness="1"
                    Padding="12,5"
                    Background="#4C8DFF"
                    BorderBrush="#40FFFFFF">
                <TextBlock x:Name="Label"
                           Text="Desktop 1"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold"
                           FontSize="12.5"
                           MaxWidth="300"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Foreground="White" />
            </Border>

            <Rectangle x:Name="DragOutline"
                       RadiusX="9"
                       RadiusY="9"
                       Stroke="#CCFFFFFF"
                       StrokeThickness="1"
                       StrokeDashArray="2 2"
                       Margin="1"
                       Visibility="Collapsed"
                       IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
